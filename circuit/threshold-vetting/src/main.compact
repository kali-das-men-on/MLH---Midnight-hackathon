import CompactStandardLibrary;

// Financial threshold proof
// privateBalance and minimumThreshold are witnesses — private inputs that
// run locally via TypeScript and never touch the chain directly.
// The only thing that crosses into public ledger state is the boolean
// result of the comparison, made public explicitly via disclose().

witness privateBalance(): Uint<64>;
witness minimumThreshold(): Uint<64>;

export ledger passed: Boolean;

export circuit thresholdVetting(): [] {
  passed = disclose(privateBalance() >= minimumThreshold());
}